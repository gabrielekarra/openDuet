# Credentials go in environment bindings or the encrypted console vault.
data_dir = ".runtime/openduet"
host = "127.0.0.1"
port = 8765
default_provider = "local"
max_turns = 20
daily_token_budget = 200000
# public_url = "https://assistant.example.com"  # Optional Telegram Mini App / OAuth.
# kev_url = "http://127.0.0.1:8768"             # Separate inference process.
# computer_url = "http://127.0.0.1:8769"        # Separate isolated browser.
# browser = true
# prototype_url = "http://127.0.0.1:8767"       # Use a distinct HTTPS hostname remotely.
# voice_model = "/absolute/path/to/downloaded-faster-whisper-model"
skills_dir = "skills"

[providers.local]
kind = "openai"
base_url = "http://127.0.0.1:11434/v1"
model = "qwen3.5:4b"  # Install your preferred model separately.
tools = true         # false enables the validated text tool protocol.
vision = false       # Enable only for a model capable of receiving uploaded images.

# LM Studio: http://127.0.0.1:1234/v1
# llama.cpp: http://127.0.0.1:8080/v1
# vLLM / MLX server / hosted compatibility providers: that server's /v1 endpoint.
# Docker: use host.docker.internal or a Compose service name instead of 127.0.0.1.

# [providers.ollama]
# kind = "ollama"
# base_url = "http://127.0.0.1:11434"
# model = "qwen3.5:4b"

# [providers.remote]
# kind = "anthropic"
# base_url = "https://api.anthropic.com/v1"
