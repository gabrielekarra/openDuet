# Copy to openduet.toml. Credentials belong in environment variables, never in this file.
data_dir = ".runtime/openduet"
host = "127.0.0.1"
port = 8765
default_provider = "local"
max_turns = 20
daily_token_budget = 200000
browser = false
browser_hosts = []  # Exact HTTPS hosts, including login and required subresource hosts.
# voice_model = "/absolute/path/to/already-downloaded-faster-whisper-model"
# notify_url = "https://your-ntfy.example/private-topic"
# notify_token_env = "NTFY_TOKEN"
# remote_session_seconds = 3600

# Remote desktop (the computer must have a VNC-compatible screen-sharing server).
# [computers.host]
# name = "My computer"
# host = "127.0.0.1"
# port = 5900
# screen_lock = "~/Library/Application Support/Bobb/screen.lock" # Mac native task handoff.
# Non-loopback targets require TLS, or a local SSH tunnel to the remote VNC port.

[providers.local]
kind = "openai"
base_url = "http://127.0.0.1:11434/v1"
model = "qwen3.5:4b"  # Install your preferred model separately in Ollama.
tools = true         # false enables the text tool protocol for models without tool calling.

# LM Studio: base_url = "http://127.0.0.1:1234/v1"
# llama.cpp: base_url = "http://127.0.0.1:8080/v1"
# vLLM / MLX server / OpenRouter / Gemini compatibility: use that service's /v1 base URL.
# In Docker, 127.0.0.1 is the container itself. Use the host gateway or another service name.

# [providers.ollama-native]
# kind = "ollama"
# base_url = "http://127.0.0.1:11434"  # Native API has no /v1 suffix.
# model = "qwen3.5:4b"

